{"nodes": [{"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_discussion", "label": "\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u8bbe\u8ba1\u8ba8\u8bba\u7a3f\uff082026-10-26\uff09", "file_type": "document", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u5f53\u8f6e\u53ea\u6574\u7406\u65b9\u6848\uff0c\u672a\u4fee\u6539\u4ee3\u7801\u6216\u90e8\u7f72\uff1b\u53f3\u4fa7\u62bd\u5c49\u3001\u5168\u5c4f\u3001\u56db\u9875\u7b7e\u968f\u67e5\u770b\u6743\u9650\u53ca\u67e5\u770b\u6253\u5370\u7559\u75d5\u5df2\u786e\u8ba4\uff0c\u5176\u4f59\u5f85\u89c4\u683c\u4efb\u52a1\u786e\u8ba4\u3002"}, {"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_four_tab_views", "label": "\u540c\u4e00\u5355\u636e\u7684\u56db\u4e2a\u5c65\u5386\u9605\u8bfb\u89c6\u56fe", "file_type": "concept", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u8ba8\u8bba\u5355\u636e\u8be6\u60c5\u3001\u52a8\u6001\u3001\u64cd\u4f5c\u65e5\u5fd7\u3001\u4fee\u6539\u65e5\u5fd7\uff1b\u52a8\u6001\u805a\u5408\u5df2\u58f0\u660e\u76f4\u63a5\u5173\u8054\u6458\u8981\uff0c\u5173\u8054\u5355\u636e\u7684\u5b8c\u6574\u65e5\u5fd7\u4ecd\u5728\u5176\u81ea\u8eab\u8be6\u60c5\u3002"}, {"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_one_event_many_views", "label": "\u540c\u4e00\u4e8b\u4ef6\u6d3e\u751f\u4e09\u4e2a\u5c65\u5386\u89c6\u56fe", "file_type": "rationale", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u5efa\u8bae\u4e8b\u4ef6\u4e3b\u8868\u52a0\u5b57\u6bb5\u53d8\u5316\u5b50\u8868\uff0c\u4ee5 eventId \u5173\u8054\u52a8\u6001\u3001\u64cd\u4f5c\u65e5\u5fd7\u3001\u4fee\u6539\u65e5\u5fd7\uff1b\u771f\u5b9e\u5173\u8054\u63a5\u5165\u540e\u624d\u5efa\u7acb\u5173\u7cfb\u7d22\u5f15\u3002", "rationale": "\u907f\u514d\u4e09\u5957\u4e8b\u5b9e\u5728\u4eba\u5458\u3001\u65f6\u95f4\u4e0e\u6570\u91cf\u4e0a\u4e0d\u4e00\u81f4\uff1b\u5173\u8054\u4e8b\u5b9e\u7559\u5386\u53f2\u4f46\u67e5\u8be2\u4ecd\u770b\u5f53\u524d\u6765\u6e90\u6743\u9650\u3002"}, {"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_view_print_intent", "label": "\u67e5\u770b\u4e0e\u53d1\u8d77\u6253\u5370\u7684\u660e\u786e\u64cd\u4f5c\u610f\u56fe", "file_type": "rationale", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u65b9\u6848\u8981\u6c42\u4e00\u6b21\u6210\u529f\u6253\u5f00\u8bb0\u5f55\u67e5\u770b\u3001\u91cd\u8bd5\u6309\u4ea4\u4e92\u6807\u8bc6\u53bb\u91cd\uff1b\u6253\u5370\u5148\u670d\u52a1\u7aef\u91cd\u65b0\u9274\u6743\u548c\u767b\u8bb0\u7248\u672c\u610f\u56fe\uff0c\u518d\u8c03\u7528\u6d4f\u89c8\u5668\u3002", "rationale": "\u5207\u9875\u7b7e\u3001\u5185\u90e8\u56de\u8bfb\u3001afterprint \u6216\u53d6\u6d88\u4e0d\u80fd\u4f2a\u88c5\u6210\u65b0\u67e5\u770b\u6216\u5b9e\u9645\u6253\u5370\u6210\u529f\u3002"}, {"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_transaction_snapshots", "label": "\u4e8b\u52a1\u5185\u5b57\u6bb5\u5dee\u5f02\u4e0e\u5b89\u5168\u5386\u53f2\u5feb\u7167", "file_type": "rationale", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u5efa\u8bae\u9501\u5b9a\u6216\u7248\u672c\u6761\u4ef6\u83b7\u5f97\u771f\u5b9e\u524d\u540e\u503c\uff0c\u4e1a\u52a1\u4e0e\u5c65\u5386\u540c\u6210\u8d25\uff1b\u4fdd\u5b58\u5b57\u6bb5key\u3001\u4e2d\u6587\u540d\u3001\u5b57\u5178\u548c\u4eba\u5458\u5feb\u7167\uff0c\u533a\u5206\u7a7a\u30010\u3001\u5426\u4e0e\u672a\u77e5\u3002", "rationale": "\u4e0d\u80fd\u7528\u4e8b\u52a1\u5916\u65e7\u503c\u548c\u524d\u7aef\u5c55\u793a\u540d\u5145\u5f53\u4e8b\u5b9e\uff0c\u79d8\u5bc6\u4e0d\u5165\u5e93\uff0c\u672a\u91c7\u96c6\u65e7\u5386\u53f2\u4e0d\u80fd\u4ece\u5f53\u524d\u6570\u636e\u8865\u7b97\u3002"}, {"id": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_scope_retention_reuse", "label": "\u4e1a\u52a1\u6388\u6743\u4fdd\u7559\u4e0e\u5206\u9636\u6bb5\u590d\u7528", "file_type": "rationale", "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\u5efa\u8bae\u5355\u636e\u9274\u6743\u540e\u8bfb\u5c65\u5386\u3001\u5173\u8054\u6765\u6e90\u518d\u9274\u6743\u3001\u8f6f\u5220\u4fdd\u7559\u53ea\u8bfb\u5386\u53f2\u4e14\u72ec\u7acb\u4fdd\u7559\u671f\uff1b\u5148\u793a\u4f8b\u95ed\u73af\uff0c\u7b2c\u4e8c\u771f\u5b9e\u4e1a\u52a1\u518d\u62bd\u53d6\u3002", "rationale": "\u5e73\u53f0\u5f02\u6b65\u5ba1\u8ba1\u4e0d\u9002\u5408\u66ff\u4ee3\u5f3a\u4e00\u81f4\u4e1a\u52a1\u5c65\u5386\uff0c\u4e5f\u4e0d\u80fd\u628a\u540c\u6b21\u7cfb\u7edf\u65e5\u5fd7\u53e0\u52a0\u6210\u7b2c\u4e8c\u6b21\u52a8\u4f5c\u3002"}], "edges": [{"source": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_discussion", "target": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_four_tab_views", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848-20261026.md", "source_location": null, "weight": 1.0}, {"source": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_discussion", "target": "docs_\u5355\u636e\u8be6\u60c5\u4e0e\u5c65\u5386\u65b9\u6848_20261026_one_event_many_views", "relation": "refere