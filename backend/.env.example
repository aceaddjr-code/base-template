NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=app_starter

JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
JWT_EXPIRES_IN=7d
PORT=3010
CORS_ORIGIN=http://localhost:5174

ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now

# UPLOAD_DIR=uploads
# BACKUP_DIR=../backups
# BACKUP_SCRIPT=../scripts/backup.mjs
# 默认使用 Node 执行 ../scripts/backup.mjs，支持 Windows/Linux；需安装 mysqldump。
# 如使用旧的 .sh 脚本，BACKUP_EXECUTABLE 配置为 bash 的可执行路径。
# BACKUP_EXECUTABLE=node
# MYSQLDUMP_BIN=mysqldump
BACKUP_TIMEOUT_MS=120000
KEEP_DAYS=30
# 审计日志保留天数，0 表示关闭自动清理；非零时分批永久清理过期日志。
AUDIT_RETENTION_DAYS=0
# development 默认 true，test/production 默认 false；生产禁止为 true。
# DB_SYNCHRONIZE=false

# HTTPS 部署设为 true；直连 HTTP 开发使用 false
COOKIE_SECURE=false
# 反向代理层数，直连为 0
TRUST_PROXY_HOPS=0
# 登录联合限流（账号安全第一批）：IP 固定窗口（跨账号累计）与账号固定窗口（跨 IP 共用）。
# 多实例经数据库共享计数；被拦截请求不延长窗口或等待，成功登录只清账号计数。
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_IP_MAX=20
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_ACCOUNT_MAX=10
BODY_LIMIT=1mb
